{
  "name": "shopfloor-twin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "verify": "pnpm format:check && turbo run typecheck test",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down --volumes",
    "stack:smoke": "sh scripts/stack-smoke.sh"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
