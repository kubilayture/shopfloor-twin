# nginx for apps/web (#99): the static build with a fallback to index.html for client-side routes,
# /api proxied to the MES (WebSocket upgrades included), and since #237 the simulation console's
# /sim/ proxy to the simulator's control API.
#
# A template (#237): the image's entrypoint renders it into /etc/nginx/conf.d/default.conf at
# start, substituting SIM_CONTROL_TOKEN only (NGINX_ENVSUBST_FILTER); nginx's own variables are
# left as they are. The token never reaches the browser: nginx adds it to the requests it proxies
# to the control API.

# The Connection header to send upstream: "upgrade" for a WebSocket handshake, otherwise "close".
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# /sim/ (#237, Phase 9 plan "Simulation console"): the MES's Origin guard never sees a console
# write (nginx's auth_request is a GET), so nginx checks it. A write, and a WebSocket upgrade (a
# page on another site could open one with the user's cookie), must come from a page of this very
# origin: its Origin equal to scheme://Host as the browser sent them (the MES checks that Host
# against HTTP_ALLOWED_HOSTS on the auth_request, so a rebound name fails there), and
# Sec-Fetch-Site, when sent, same-origin. A read without an upgrade needs neither.
map "$request_method:$http_upgrade" $sim_write {
    "~^(GET|HEAD):$" 0;
    default 1;
}
map "$http_origin|$scheme://$http_host" $sim_same_origin {
    "~^([^|]+)\|\1$" 1;
    default 0;
}
map "$sim_write:$sim_same_origin:$http_sec_fetch_site" $sim_origin_refused {
    "~^0:" 0;
    "~^1:1:(same-origin)?$" 0;
    default 1;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    # Docker's DNS, re-asked every 10 s: a recreated MES or simulator container (new address) is
    # found again, and nginx starts even while either is down (answering 502 until it is back).
    resolver 127.0.0.11 valid=10s ipv6=off;
    # The MES by its alias on the internal `edge` network (#237), never `mes`: the MES trusts the
    # proxy headers below (X-Original-Method; X-Real-IP from P9-15) only from that network, and
    # `mes` may resolve to its address on the default network. mes_http_proxy_requests_total{trusted}
    # counts what arrives; the smoke asserts that nothing arrives untrusted.
    set $mes_upstream http://mes-edge:4700;
    # The simulator's control API (#237), on the default network; reached only through /sim/.
    set $sim_upstream http://simulator:4800;
    set $sim_token "${SIM_CONTROL_TOKEN}";
    charset utf-8;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json application/problem+json
        image/svg+xml text/plain;

    # Container healthcheck; not logged.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # Only the methods the API uses (ADR-0023): GET (with HEAD), POST, PUT and DELETE. Any
        # other (OPTIONS, PATCH, TRACE, …) is refused here with 403 and never reaches the MES.
        limit_except GET POST PUT DELETE {
            deny all;
        }
        # The MES takes write bodies up to 16 KiB; larger ones stop here with 413.
        client_max_body_size 16k;
        # A variable without a URI part: the request URI is passed on unchanged.
        proxy_pass $mes_upstream;
        proxy_http_version 1.1;
        # The browser's own Host (with port): the MES checks the name against HTTP_ALLOWED_HOSTS
        # (DNS rebinding) and accepts a WebSocket whose Origin names this same host and port
        # (ADR-0019), so HTTP_ALLOWED_ORIGINS stays empty. $host would drop the port and fail
        # the Origin check.
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # The client's address, overwriting whatever it sent (#237; the MES believes it only from
        # the edge network, and uses it from P9-15).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The MES pings every 15 s, so an open WebSocket is never idle this long; REST answers
        # are bounded by the MES's 5 s statement timeout.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # Pushed messages go out as they come.
        proxy_buffering off;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The console's permission check (#237): before every allowlisted /sim/ request. A GET (nginx
    # makes every subrequest a GET) without a body; the console request's method goes in
    # X-Original-Method, so only a non-GET action counts as use of the session (the 1 s status
    # poll doesn't keep an unattended console signed in). 204 lets the request through; 401 and
    # 403 are answered to the browser as they are; anything else (503 while the MES starts) is a
    # 500.
    location = /_sim/auth {
        internal;
        proxy_pass $mes_upstream/api/v1/session/permission/sim:control;
        proxy_method GET;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Content-Type "";
        proxy_set_header Upgrade "";
        proxy_set_header Connection "close";
        proxy_set_header Host $http_host;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The /sim/ allowlist (#237): exact routes and methods of the control API the console uses,
    # nothing by prefix. Not proxied, among others: GET /ground-truth (the test oracle) and
    # GET /scenario/recorded (it carries the seed and configSha256, so the run's future could be
    # predicted from it), /health/*, /metrics. Anything else under /sim/ is 404; a method a route
    # doesn't allow is 403. Each allowed request passes, in this order: the Origin check (403),
    # the permission check (401, 403), then the control API with nginx's token.
    location = /sim/api/v1/status {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/pause {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/resume {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/step {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/speed {
        limit_except PUT { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/faults/modbus {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location ~ ^/sim/api/v1/faults/(opcua|failure|drift|tool)/[A-Za-z0-9._-]+$ {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/faults/injections {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/faults/drifts {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/lots {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location ~ ^/sim/api/v1/lots/[A-Za-z0-9._-]+/(block|release)$ {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/operators {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/operators/absent {
        limit_except POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/actions {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/scenario {
        limit_except GET POST { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    location = /sim/api/v1/scenarios {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
    }
    # The plant event stream (WebSocket): read-only; a paused run may send nothing for long.
    location = /sim/api/v1/events {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/sim-proxy.conf;
        proxy_read_timeout 1h;
    }
    location /sim/ {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        return 404 '{"error":"Not Found","message":"not a console route"}\n';
    }

    # Hashed file names change with their content: cache for a year.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Client-side routes (/equipment/cnc-01) get index.html; it is always revalidated so a new
    # build is picked up at once.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
