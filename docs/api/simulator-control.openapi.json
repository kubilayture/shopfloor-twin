    "/api/v1/ground-truth": {
      "get": {
        "summary": "Time per state, per machine and shift bucket, so far (the headless summary, live)",
        "tags": [
          "simulation"
        ],
        "description": "The ground truth a headless run would write if it ended now, kept live while the run is paced. Reconciliation tests compare the MES with it (#100). Reading it never moves the run.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "epoch": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "Run epoch (Unix seconds), as the devices publish it (ADR-0015)"
                    },
                    "start": {
                      "type": "string",
                      "description": "Simulation start, ISO 8601 UTC"
                    },
                    "simTime": {
                      "type": "string",
                      "description": "How far events have been processed, ISO 8601 UTC; the totals count up to here"
                    },
                    "pacedTime": {
                      "type": "string",
                      "description": "The paced simulation clock when this was read, ISO 8601 UTC; simTime trails it by up to about 1 s × speed while running"
                    },
                    "currentBucket": {
                      "type": "string",
                      "description": "The shift bucket the run is in: `2026-10-12/A` or `no-shift`"
                    },
                    "buckets": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "complete": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "complete"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Every bucket seen; complete once the run has left it (`no-shift` collects every gap between shifts and can be entered again)"
                    },
                    "current": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "enum": [
                              "Off",
                              "Idle",
                              "Running",
                              "Stopped",
                              "Starved",
                              "Blocked",
                              "Setup",
                              "Down",
                              "PlannedStop",
                              "Maintenance"
                            ]
                          },
                          "since": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "state",
                          "since"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Each machine's current state and when it began"
                    },
                    "machines": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "stateMs": {
                            "type": "object",
                            "properties": {
                              "Off": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Idle": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Running": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Stopped": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Starved": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Blocked": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Setup": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Down": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "PlannedStop": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "Maintenance": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "Off",
                              "Idle",
                              "Running",
                              "Stopped",
                              "Starved",
                              "Blocked",
                              "Setup",
                              "Down",
                              "PlannedStop",
                              "Maintenance"
                            ],
                            "additionalProperties": false,
                            "description": "Simulation milliseconds per machine state"
                          },
                          "byShift": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "Off": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Idle": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Running": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Stopped": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Starved": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Blocked": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Setup": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Down": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "PlannedStop": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "Maintenance": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "Off",
                                "Idle",
                                "Running",
                                "Stopped",
                                "Starved",
                                "Blocked",
                                "Setup",
                                "Down",
                                "PlannedStop",
                                "Maintenance"
                              ],
                              "additionalProperties": false,
                              "description": "Simulation milliseconds per machine state"
                            }
                          },
                          "cycles": {
                            "type": "object",
                            "properties": {
                              "good": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "scrap": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "rework": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "good",
                              "scrap",
                              "rework"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "stateMs",
                          "byShift",
                          "cycles"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Per machine, as in the headless summary.json"
                    },
                    "production": {
                      "type": "object",
                      "properties": {
                        "started": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "finished": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "scrapped": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          }
                        }
                      },
                      "required": [
                        "started",
                        "finished",
                        "scrapped"
                      ],
                      "additionalProperties": false
                    },
                    "lots": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Remaining quantity per material lot"
                    }
                  },
                  "required": [
                    "epoch",
                    "start",
                    "simTime",
                    "pacedTime",
                    "currentBucket",
                    "buckets",
                    "current",
                    "machines",
                    "production",
                    "lots"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/faults/modbus": {
