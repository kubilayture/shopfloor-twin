                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "idle",
                        "running",
                        "paused",
                        "finished"
                      ]
                    },
                    "speed": {
                      "type": "number",
                      "description": "Simulation seconds per wall-clock second"
                    },
                    "simTime": {
                      "type": "string",
                      "description": "Current simulation time, ISO 8601 UTC"
                    },
                    "lagMs": {
                      "type": "number",
                      "description": "How far event processing trails the paced clock, in wall ms"
                    },
                    "events": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
