{
  "name": "@shopfloor/mes-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "node src/main.ts",
    "migrate": "node src/db/cli.ts",
    "user:create": "node src/user-cli.ts",
    "user:disable": "node src/user-cli.ts --disable",
    "openapi": "node src/openapi.ts",
    "data-model": "node src/db/data-model.ts"
  },
  "dependencies": {
    "@fastify/swagger": "catalog:",
    "@fastify/websocket": "catalog:",
    "@shopfloor/alarm-core": "workspace:*",
    "@shopfloor/contracts": "workspace:*",
    "@shopfloor/oee-core": "workspace:*",
    "@shopfloor/plant-config": "workspace:*",
    "@shopfloor/shift-calendar": "workspace:*",
    "fastify": "catalog:",
    "kysely": "catalog:",
    "mqtt": "catalog:",
    "pg": "catalog:",
    "prom-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shopfloor/eslint-config": "workspace:*",
    "@shopfloor/test-kit": "workspace:*",
    "@shopfloor/trace-core": "workspace:*",
    "@shopfloor/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
