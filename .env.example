DB_NAME=shopfloor
DB_USER=shopfloor
DB_PASSWORD=change-me
# The MES's own database role `mes_app` (#169, ADR-0027): the `migrate` step sets this password,
# the MES connects with it; DB_USER/DB_PASSWORD (the bootstrap superuser) only migrate.
DB_APP_PASSWORD=change-me
DB_PORT=5442
DB_TUNE_MEMORY=512MB
DB_TUNE_CPUS=2

MQTT_PORT=1883
MQTT_HEALTHCHECK_PASSWORD=change-me
MQTT_DEV_PASSWORD=change-me
MQTT_GATEWAY_PASSWORD=change-me
MQTT_MES_PASSWORD=change-me

SIM_SEED=1
SIM_SPEED=60
SIM_AUTOSTART=true
SIM_PRODUCTION=schedule
SIM_CONTROL_PORT=4800
SIM_LOG_LEVEL=info
# The simulator control API's bearer token (#237, required): every control route but /health/* and
# /metrics needs it, reads included. nginx adds it to the console's /sim/ requests, so the browser
# never holds it; your own tools send `Authorization: Bearer <token>`. Random per stack, 16-512
# characters of A-Z a-z 0-9 . _ ~ + / = - (for example `openssl rand -hex 16`). No default: Compose
# refuses to start without it.
SIM_CONTROL_TOKEN=
# How long a plant-event stream connection lives before the simulator closes it (4100) and the
# console reconnects through nginx's session check (#237): a logout ends the stream within this.
# SIM_EVENTS_LIFETIME_MS=300000
# OPC UA users (#239, ADR-0038, required): the simulator's five servers accept only SignAndEncrypt
# sessions from a certificate the `pki` step pinned, as one of two users. `opcua-gateway` (the edge
# gateway; the only user that may call LoadOrder and LoadProgram) and `opcua-reader` (browse and
# read: development tools, `docker compose run --rm opcua-tools`, the smoke). Random per stack, 16-512
# characters without whitespace (for example `openssl rand -hex 16`). No default: Compose refuses to
# start without them.
OPCUA_GATEWAY_PASSWORD=
OPCUA_READER_PASSWORD=
# SIM_START=2026-10-12T06:00:00+03:00
# SIM_OPCUA_HOST=localhost
# A timeline of config/scenarios played live from the start (#235); its seed and start must be the
# run's: monday-breakdown-and-recovery needs SIM_SEED=20261012 (and the default SIM_START).
# SIM_TIMELINE=monday-breakdown-and-recovery

GATEWAY_HTTP_PORT=4900
GATEWAY_LOG_LEVEL=info
# Command path (#173, ADR-0029): the deadline of each OPC UA request of a command (calls, epoch and
# sequence reads) and the MQTT 5 session expiry of the gateway's command session (client id
# gw-01-cmd), which must outlast any command.
# GATEWAY_CALL_DEADLINE_MS=5000
# GATEWAY_CMD_SESSION_EXPIRY_S=3600

# MES (#99): API and WebSocket on 127.0.0.1:MES_HTTP_PORT. It connects to the database as
# `mes_app` with DB_APP_PASSWORD (#169; the `migrate` service migrates first, as DB_USER) and to
# the broker as `mes` with MQTT_MES_PASSWORD.
MES_HTTP_PORT=4700
MES_LOG_LEVEL=info
# Host names the browser may use for the web app and the API (DNS-rebinding check). Add a name
# here if you open the app under another one; a 403 "host not allowed" means it is missing.
# MES_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Extra origins for WebSockets and writes; not needed while the page comes from the web container.
# MES_ALLOWED_ORIGINS=
# Downtime coding writes (#121, ADR-0023): `off` answers every write with 405 (read-only MES).
# MES_WRITES=on
# Identity (#168, #170, ADR-0026): every API route and the WebSocket need a login (session
# cookie); the web app has its login at /login. `off` only for one-off diagnosis: reads and the
# WebSocket are then served without a session, writes still need one, and the MES logs a warning.
# MES_AUTH=on
# Optional: creates the user `admin` (it must change the password at first login) when no enabled
# admin exists. 12–128 characters; leave empty and use `user:create` instead (runbook). Without
# any admin nobody can log in to manage users: set one of the two on a new stack.
MES_BOOTSTRAP_ADMIN_PASSWORD=
# The command path (#174, ADR-0029), wall ms: a delivery's life (expiresAt), the wait for an
# answer before a resend, deliveries at most, and the margin after the last expiresAt before a
# command without a final answer is `failed` (an incident; never final). Defaults shown.
# COMMAND_TTL_MS=60000
# COMMAND_RESEND_MS=15000
# COMMAND_ATTEMPTS=5
# COMMAND_FAIL_MARGIN_MS=30000

# ERP mock (#171, ADR-0028): REST on 127.0.0.1:ERP_HTTP_PORT. The MES authenticates with the
# shared bearer token ERP_API_TOKEN (required; replace change-me with a random value).
ERP_HTTP_PORT=4600
ERP_API_TOKEN=change-me
# How often the MES pulls the ERP's order feed (#174), wall ms.
# ERP_POLL_MS=10000
ERP_LOG_LEVEL=info
# The dev-only POST /api/v1/orders (adds orders for demos): `on` to enable.
# ERP_ADMIN=off

# Web app (nginx, proxies /api to the MES and the console's allowlisted /sim/ routes to the
# simulator, #237): http://localhost:WEB_PORT. The simulation console is /console (role admin).
WEB_PORT=8080
