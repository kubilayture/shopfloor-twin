{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "uns.events.cycle-complete/1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Start of the sequence owner, Unix seconds"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Simulation (device) time of the fact"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Gateway wall time when it read the fact"
    },
    "quality": {
      "type": "string",
      "enum": [
        "good",
        "uncertain",
        "bad"
      ],
      "description": "OPC UA-style quality: bad means the value must not be used"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Equipment id (cnc-01, wsh-01) or component instance (gw-01)"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "opcua",
            "modbus",
            "internal"
          ],
          "description": "Where the gateway got it"
        }
      },
      "required": [
        "id",
        "protocol"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "const": "device"
    },
    "value": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "partId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "serial": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "good",
            "scrap",
            "rework"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurement": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "characteristic": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "upperLimit": {
                  "type": "number"
                }
              },
              "required": [
                "characteristic",
                "value",
                "unit",
                "upperLimit"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "lots": {
          "description": "The lots the machine consumed for this part on this cycle, in consumption order (1.4); [] when none",
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Material code, e.g. BLANK-100"
              },
              "lot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Lot id, e.g. BL100-2610-01"
              }
            },
            "required": [
              "material",
              "lot"
            ],
            "additionalProperties": false
          }
        },
        "operator": {
          "description": "The station's operator when the cycle started (1.4); null where the machine has none or the cycle consumed nothing",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "product",
        "partId",
        "serial",
        "result",
        "reason",
        "measurement"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "epoch",
    "seq",
    "sourceTime",
    "receivedAt",
    "quality",
    "source",
    "scope",
    "value"
  ],
  "additionalProperties": false,
  "title": "uns.events.cycle-complete/1",
  "description": "A completed cycle (not retained)"
}
