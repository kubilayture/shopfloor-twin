    "/api/v1/step": {
      "post": {
        "summary": "Process exactly one simulation event (only while paused or not yet started)",
        "tags": [
          "simulation"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stepped": {
                      "type": "boolean",
                      "description": "False when there is no event left to process"
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "enum": [
                            "idle",
                            "running",
                            "paused",
                            "finished"
                          ]
                        },
                        "speed": {
                          "type": "number",
                          "description": "Simulation seconds per wall-clock second"
                        },
                        "simTime": {
                          "type": "string",
                          "description": "Current simulation time, ISO 8601 UTC"
                        },
                        "lagMs": {
                          "type": "number",
                          "description": "How far event processing trails the paced clock, in wall ms"
                        },
                        "events": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Plant events emitted since start"
                        }
                      },
                      "required": [
                        "state",
                        "speed",
                        "simTime",
                        "lagMs",
                        "events"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "stepped",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "additionalProperties": false
                }
