{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "uns.telemetry/1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Start of the sequence owner, Unix seconds"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Simulation (device) time of the fact"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Gateway wall time when it read the fact"
    },
    "quality": {
      "type": "string",
      "enum": [
        "good",
        "uncertain",
        "bad"
      ],
      "description": "OPC UA-style quality: bad means the value must not be used"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Equipment id (cnc-01, wsh-01) or component instance (gw-01)"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "opcua",
            "modbus",
            "internal"
          ],
          "description": "Where the gateway got it"
        }
      },
      "required": [
        "id",
        "protocol"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "const": "topic"
    },
    "deviceEpoch": {
      "description": "The device epoch (ADR-0015) the value was read in, when known; epoch is the gateway counter epoch",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "value": {
      "type": "number"
    }
  },
  "required": [
    "schema",
    "epoch",
    "seq",
    "sourceTime",
    "receivedAt",
    "quality",
    "source",
    "unit",
    "scope",
    "value"
  ],
  "additionalProperties": false,
  "title": "uns.telemetry/1",
  "description": "A sampled process value (retained, last value)"
}
