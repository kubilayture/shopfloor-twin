{
  "name": "@shopfloor/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:reconcile": "node ../scripts/heavy.ts node src/reconcile.ts",
    "test:trace-perf": "node ../scripts/heavy.ts node src/trace-perf.ts",
    "test:perf": "node ../scripts/heavy.ts node src/perf.ts",
    "test:console": "node ../scripts/heavy.ts node src/console-pass.ts",
    "test:resilience": "node ../scripts/heavy.ts node src/resilience.ts",
    "demo": "node ../scripts/heavy.ts node src/demo.ts",
    "demo:probe": "node src/demo-probe.ts",
    "demo:record": "node ../scripts/heavy.ts node src/demo.ts --record",
    "test:fresh-clone": "node ../scripts/heavy.ts node src/fresh-clone.ts",
    "playwright:install": "playwright install --only-shell chromium",
    "playwright:install:webkit": "playwright install webkit"
  },
  "dependencies": {
    "@playwright/test": "catalog:",
    "@shopfloor/contracts": "workspace:*",
    "@shopfloor/plant-config": "workspace:*",
    "@shopfloor/shift-calendar": "workspace:*",
    "@shopfloor/spc-core": "workspace:*",
    "@shopfloor/trace-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@shopfloor/eslint-config": "workspace:*",
    "@shopfloor/pki": "workspace:*",
    "@shopfloor/test-kit": "workspace:*",
    "@shopfloor/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
