{
  "name": "shopfloor-twin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "verify": "node scripts/heavy.ts pnpm run verify:steps",
    "verify:steps": "pnpm format:check && pnpm check:dockerfiles && turbo run lint typecheck test build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/heavy.ts turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dockerfiles": "tsc -p . && node scripts/check-dockerfiles.ts",
    "prepare": "lefthook install",
    "stack:up": "docker compose up -d --wait",
    "stack:up:dev": "docker compose --file docker-compose.yml --file compose.dev-ports.yml up -d --wait",
    "stack:up:observability": "docker compose --file docker-compose.yml --file compose.observability.yml --profile observability up -d --wait",
    "stack:down:observability": "docker compose --file docker-compose.yml --file compose.observability.yml --profile observability down",
    "stack:smoke:observability": "node scripts/observability-smoke.ts",
    "stack:ca": "node scripts/dev-ca.ts",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down --volumes",
    "stack:smoke": "sh scripts/stack-smoke.sh",
    "sim:headless": "pnpm --filter @shopfloor/simulator headless",
    "test:golden": "pnpm --filter @shopfloor/simulator test:golden",
    "sim:live": "pnpm --filter @shopfloor/simulator live",
    "sim:serve": "pnpm --filter @shopfloor/simulator serve",
    "test:e2e": "node scripts/heavy.ts turbo run test:e2e --concurrency=1",
    "test:reconcile": "pnpm --filter @shopfloor/e2e test:reconcile",
    "test:trace-perf": "pnpm --filter @shopfloor/e2e test:trace-perf",
    "test:console": "pnpm --filter @shopfloor/e2e test:console",
    "gate": "node scripts/gate.ts",
    "playwright:install": "pnpm --filter @shopfloor/e2e playwright:install"
  },
  "devDependencies": {
    "@shopfloor/eslint-config": "workspace:*",
    "@shopfloor/test-kit": "workspace:*",
    "@shopfloor/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
